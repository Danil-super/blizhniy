[Unit]
Description=Blizhniy private user access operator socket

[Socket]
ListenStream=/run/blizhniy-user-access/operator.sock
SocketUser=root
SocketGroup=blizhniy-web
SocketMode=0660
DirectoryMode=0755
FileDescriptorName=operator
Accept=no
Backlog=8
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
