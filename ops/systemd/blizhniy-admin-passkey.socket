[Unit]
Description=Blizhniy administrator passkey verifier socket

[Socket]
ListenStream=/run/blizhniy-admin-passkey/operator.sock
SocketUser=root
SocketGroup=blizhniy-web
SocketMode=0660
DirectoryMode=0755
FileDescriptorName=operator
Accept=no
Backlog=8
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
