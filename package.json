{
  "name": "blizhniy-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js . --ignore-pattern 'vendor/postcss-selector-parser/**'",
    "check:floor": "node scripts/check-quality-floor.mjs",
    "check:types": "node node_modules/typescript/bin/tsc --noEmit",
    "check:fast": "npm run check:floor && npm run check:types && npm run lint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.cjs scripts/test-*.mjs",
    "test:coverage:native": "node scripts/run-native-coverage.mjs",
    "seed:production": "node scripts/seed-production-data.mjs",
    "db:local": "node scripts/local-payment-db.mjs",
    "db:check": "node --experimental-strip-types scripts/check-postgres.mjs",
    "test:postgres:local": "node --experimental-strip-types --test tests/postgres-integration.mjs",
    "supabase:local": "node scripts/local-supabase.mjs",
    "dev:local": "node scripts/local-supabase.mjs dev",
    "test:app:local": "node --test tests/local-supabase-integration.mjs",
    "test:payments:local": "node --test tests/local-payment-db-postgres.mjs tests/payment-lifecycle-integration-postgres.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.27",
    "pg": "8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.27",
    "playwright": "^1.61.0",
    "postcss": "^8.5.23",
    "postcss-selector-parser": "file:vendor/postcss-selector-parser",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.5"
    },
    "source-map-js": "1.2.2"
  }
}
