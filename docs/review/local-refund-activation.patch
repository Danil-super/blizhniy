+import assert from 'node:assert/strict';import {test} from 'node:test';import {spawnSync} from 'node:child_process';
+
+test('local CLI accepts refund opt-in only on start/background and rejects other arguments before fixture access',()=>{
+ for(const [args,expected] of [[[],0],[['--prepare','--refunds'],0],[['--start','--other'],0],[['--background','--refunds','extra'],0],[['--start','--refunds'],1],[['--background','--refunds'],1],[['--start'],1]]){
+  const script=`
+   import assert from 'node:assert/strict';import fs from 'node:fs';import child from 'node:child_process';import {syncBuiltinESMExports} from 'node:module';
+   let fixture=0;const original=fs.promises.mkdir;fs.promises.mkdir=async(path,...args)=>{if(String(path).includes('/.local/state/blizhniy/')){fixture++;throw Error('Fixture forbidden');}return original(path,...args);};
+   child.execFile=()=>{throw Error('Processes forbidden');};globalThis.fetch=()=>{throw Error('Network forbidden');};syncBuiltinESMExports();
+   process.argv=['node',process.cwd()+'/scripts/local-primary.mjs',...JSON.parse(process.argv[1])];console.error=()=>{};
+   await import('./scripts/local-primary.mjs');await new Promise(resolve=>setTimeout(resolve,20));
+   assert.equal(fixture,${expected});assert.equal(process.exitCode,1);process.exitCode=0;console.log('checked');
+  `;
+  const result=spawnSync(process.execPath,['--experimental-strip-types','--input-type=module','-e',script,JSON.stringify(args)],{env:{PATH:process.env.PATH,LANG:'C.UTF-8'},encoding:'utf8',timeout:15000});
+  assert.equal(result.status,0,result.stderr);assert.equal(result.stdout.trim(),'checked');
+ }
+});
diff --git a/tests/local-primary-proxy-cleanup.test.mjs b/tests/local-primary-proxy-cleanup.test.mjs
new file mode 100644
index 0000000..458e0fe
--- /dev/null
+++ b/tests/local-primary-proxy-cleanup.test.mjs
@@ -0,0 +1,31 @@
+import assert from 'node:assert/strict';import {test} from 'node:test';import {spawnSync} from 'node:child_process';
+
+test('proxy startup unwinds both pools and the mail timer on auth and late TLS failures without reading the manual fixture',()=>{
+ const script=`
+  import assert from 'node:assert/strict';import fs from 'node:fs';import childProcess from 'node:child_process';import {syncBuiltinESMExports,createRequire} from 'node:module';import pg from 'pg';
+  const state={project:process.cwd(),origin:'https://127.0.0.1:3045',upstreamPort:3046,containerId:'a'.repeat(64),containerName:'blizhniy-primary-local-123456789abc',dbPort:35432,database:'blizhniy_prod',runtimePassword:'b'.repeat(64),ownerPassword:'c'.repeat(64),rateSecret:'d'.repeat(64)};
+  const metadata={Id:state.containerId,Name:'/'+state.containerName,Config:{Image:'postgres@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873',Labels:{'blizhniy.primary-local':state.project}},NetworkSettings:{Ports:{'5432/tcp':[{HostIp:'127.0.0.1',HostPort:'35432'}]}}};
+  childProcess.execFile=(_cmd,args,_options,callback)=>{assert.equal(args.includes('inspect'),true);callback(null,{stdout:JSON.stringify([metadata])});};
+  let stage,pools=0,closed=0,timers=0,cleared=0,network=0;
+  globalThis.fetch=()=>{network++;throw Error('Network forbidden');};
+  globalThis.setInterval=()=>{timers++;return{};};globalThis.clearInterval=value=>{if(value)cleared++;};
+  pg.Pool=class{constructor(){pools++;}};
+  const read=fs.promises.readFile;fs.promises.readFile=async(file,...args)=>{
+   if(String(file).endsWith('/tls-key.pem')||String(file).endsWith('/tls-cert.pem')){if(stage==='read')throw Error('Synthetic TLS read failure');return Buffer.from('synthetic invalid PEM');}
+   if(String(file).endsWith('/mail-key.bin'))return Buffer.alloc(32);
+   if(String(file).includes('/.local/state/'))throw Error('Permanent fixture access forbidden');return read(file,...args);
+  };syncBuiltinESMExports();
+  const fake=()=>({}),require=createRequire(import.meta.url);
+  require('./scripts/local-primary-modules.cjs').loadLocalPrimaryModule=name=>{
+   if(name==='postgres')return{PostgresDatabase:class{async close(){closed++;}}};
+   if(name==='production-auth-database')return{verifyProductionAuthDatabase:async()=>{if(stage==='auth')throw Error('Synthetic auth failure');}};
+   if(name==='telegram-phone-config')return{readTelegramPhoneConfig:()=>null};
+   return new Proxy({}, {get:()=>function(){return fake();}});
+  };
+  const {createLocalPrimaryProxy}=await import('./scripts/local-primary-proxy.mjs');
+  for(stage of ['read','auth','tls']){pools=closed=timers=cleared=0;await assert.rejects(createLocalPrimaryProxy(state));assert.equal(pools,stage==='read'?0:2);assert.equal(closed,pools);assert.equal(timers,stage==='tls'?1:0);assert.equal(cleared,timers);}
+  assert.equal(network,0);console.log('cleanup verified');
+ `;
+ const child=spawnSync(process.execPath,['--experimental-strip-types','--input-type=module','-e',script],{env:{PATH:process.env.PATH,LANG:'C.UTF-8',NODE_ENV:'test'},encoding:'utf8',timeout:20000});
+ assert.equal(child.status,0,child.stderr);assert.equal(child.stdout.trim(),'cleanup verified');
+});
diff --git a/tests/local-primary-refund-activation-cases.mjs b/tests/local-primary-refund-activation-cases.mjs
new file mode 100644
index 0000000..c1d1798
--- /dev/null
+++ b/tests/local-primary-refund-activation-cases.mjs
@@ -0,0 +1,45 @@
+import assert from 'node:assert/strict';
+import {randomUUID} from 'node:crypto';
+import {readFile,writeFile,readdir} from 'node:fs/promises';
+import {dirname,join} from 'node:path';
+import {startLocalPrimaryRefunds} from '../scripts/local-primary-refunds.mjs';
+
+export async function testLocalPrimaryRefundActivation(suite,{admin,ownerDb,load,intent,environment,workerEnvironment,stateFile,actor,token}){
+ await suite.test('manual activation builds fresh artifacts and connects the real HTTP boundary to TLS roles and durable fake refunds',async()=>{
+  const state=JSON.parse(await readFile(stateFile,'utf8')),parent=dirname(stateFile),keys=['NODE_ENV','BLIZHNIY_LOCAL_PRIMARY','BLIZHNIY_LOCAL_PRIMARY_ORIGIN'];
+  const saved=Object.fromEntries(keys.map(key=>[key,process.env[key]]));let services;
+  try{
+   Object.assign(process.env,{NODE_ENV:'test',BLIZHNIY_LOCAL_PRIMARY:'enabled',BLIZHNIY_LOCAL_PRIMARY_ORIGIN:state.origin});
+   await writeFile(join(parent,'refunds.json'),JSON.stringify({version:1,project:state.project,containerId:state.containerId,operatorPassword:environment.BLIZHNIY_DB_PASSWORD,workerPassword:workerEnvironment.BLIZHNIY_DB_PASSWORD}),{mode:0o600});
+   await writeFile(join(parent,'refund-db-ca.pem'),await readFile(environment.BLIZHNIY_DB_CA_FILE),{mode:0o600});
+   const source=(await admin.query("select author_id,category_id,city_id,contact_phone from app.listings where title='Синтетическая публикация'")).rows[0];
+   const listing=(await admin.query("insert into app.listings(author_id,listing_type,category_id,city_id,title,description,contact_phone,created_at) values($1,'sell',$2,$3,'Проверка ручного запуска','Синтетическая проверка HTTP, отдельного сокета и устойчивого провайдера.',$4,clock_timestamp()-interval '2 minutes') returning id",[source.author_id,source.category_id,source.city_id,source.contact_phone])).rows[0].id;
+   const payment=await intent('listing',listing,source.author_id);
+   await admin.query("insert into local_primary.provider_payments(intent_id,provider_id,status,captured_at) values($1,$2,'succeeded',$3)",[payment.id,payment.providerPaymentId,payment.capturedAt]);
+   assert.equal((await new(load('postgres-listing-payment-fulfillment').PostgresListingPaymentFulfillmentStore)(ownerDb,{shopId:environment.BLIZHNIY_PAYMENT_SHOP_ID,isTest:true},{postmoderation:true}).fulfill(payment.id)).state,'fulfilled');
+   const {createAdminRefundHandler}=load('admin-refund-http'),{callLocalRefundOperator}=load('local-refund-operator-client');
+   for(let restart=0;restart<2;restart++){
+    const controller=new AbortController(),events=[];
+    services=await startLocalPrimaryRefunds({stateFile,signal:controller.signal,report:async event=>events.push(event)});
+    const socket=services.socketPath;
+    const handler=createAdminRefundHandler({origin:'https://admin.example.invalid'},()=>({limiter:new(load('auth-http').AuthRateLimiter)(ownerDb,state.rateSecret),command:(...args)=>callLocalRefundOperator(socket,...args)}),()=>{});
+    const request=command=>new Request('https://admin.example.invalid/api/admin/refunds',{method:'POST',headers:{host:'admin.example.invalid',origin:'https://admin.example.invalid','content-type':'application/json','x-blizhniy-request':'1','x-real-ip':'127.0.0.1',cookie:'__Host-blizhniy_session='+token},body:JSON.stringify(command)});
+    if(restart===0){
+     const approved=await handler(request({action:'approve',expectedAdminId:actor,input:{id:randomUUID(),paymentIntentId:payment.id,reason:'Полный возврат через ручной локальный контур.'}}));assert.equal(approved.status,200);
+     const deadline=Date.now()+20000;
+     while((await admin.query('select count(*)::int as n from app.payment_refund_effects where payment_intent_id=$1',[payment.id])).rows[0].n===0){assert.ok(Date.now()<deadline,'owned worker completes the queued refund');await new Promise(resolve=>setTimeout(resolve,100));}
+    }
+    const listed=await handler(request({action:'list',expectedAdminId:actor,input:null}));assert.equal(listed.status,200);
+    assert.ok((await listed.json()).items.some(row=>row.id===payment.id&&row.status==='refunded'));
+    assert.equal(events[0].status,'ready');await services.close();assert.equal(await services.done,0);services=undefined;
+    assert.equal((await handler(request({action:'list',expectedAdminId:actor,input:null}))).status,503);
+    assert.equal((await readdir(parent)).filter(name=>name.startsWith('refund-runtime-')).length,0);
+   }
+   assert.equal((await admin.query('select count(*)::int as n from app.payment_refund_effects where payment_intent_id=$1',[payment.id])).rows[0].n,1);
+   assert.equal((await admin.query('select count(*)::int as n from app.notifications where event_key=$1',['placement_refund:'+payment.id])).rows[0].n,1);
+   assert.equal((await admin.query("select count(*)::int as n from pg_stat_activity where application_name in ('blizhniy-local-refund-provider','blizhniy-local-refund-worker','blizhniy-local-refund-operator')")).rows[0].n,0);
+  }finally{
+   try{await services?.close();}finally{for(const key of keys)if(saved[key]===undefined)delete process.env[key];else process.env[key]=saved[key];}
+  }
+ });
+}
diff --git a/tests/local-primary-refund-config.test.mjs b/tests/local-primary-refund-config.test.mjs
new file mode 100644
index 0000000..70e1e1c
--- /dev/null
+++ b/tests/local-primary-refund-config.test.mjs
@@ -0,0 +1,37 @@
+import assert from 'node:assert/strict';
+import {test} from 'node:test';
+import {mkdtempSync,writeFileSync,chmodSync,symlinkSync,linkSync,rmSync} from 'node:fs';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {readLocalPrimaryRefundConfig} from '../scripts/local-primary-refund-config.mjs';
+import {spawnSync} from 'node:child_process';
+
+test('refund credentials are private, bounded and bound to the exact owned project and container',()=>{
+ const directory=mkdtempSync(join(tmpdir(),'blizhniy-refund-config-')),file=join(directory,'refunds.json');
+ const state={project:process.cwd(),containerId:'a'.repeat(64),origin:'https://127.0.0.1:3045',database:'blizhniy_prod',ownerPassword:'b'.repeat(64),runtimePassword:'c'.repeat(64)};
+ const value={version:1,project:state.project,containerId:state.containerId,operatorPassword:'d'.repeat(64),workerPassword:'e'.repeat(64)};
+ try{
+  chmodSync(directory,0o700);writeFileSync(file,JSON.stringify(value),{mode:0o600});assert.deepEqual(readLocalPrimaryRefundConfig(file,state),value);
+  for(const patch of [{version:2},{project:'/foreign'},{containerId:'f'.repeat(64)},{operatorPassword:state.ownerPassword},{workerPassword:state.runtimePassword},{workerPassword:value.operatorPassword},{workerPassword:''},{extra:true}]){
+   writeFileSync(file,JSON.stringify({...value,...patch}));assert.throws(()=>readLocalPrimaryRefundConfig(file,state),{message:'Local refund configuration unavailable'});
+  }
+  writeFileSync(file,JSON.stringify(value));symlinkSync(file,join(directory,'link'));assert.throws(()=>readLocalPrimaryRefundConfig(join(directory,'link'),state));
+  linkSync(file,join(directory,'hardlink'));assert.throws(()=>readLocalPrimaryRefundConfig(file,state));rmSync(join(directory,'hardlink'));
+  chmodSync(file,0o644);assert.throws(()=>readLocalPrimaryRefundConfig(file,state));chmodSync(file,0o600);
+  writeFileSync(file,'x'.repeat(2049));assert.throws(()=>readLocalPrimaryRefundConfig(file,state));writeFileSync(file,JSON.stringify(value));
+  chmodSync(directory,0o755);assert.throws(()=>readLocalPrimaryRefundConfig(file,state));
+ }finally{rmSync(directory,{recursive:true,force:true});}
+});
+
+test('refund config caps actual reads when its inode grows after stat',()=>{
+ const directory=mkdtempSync(join(tmpdir(),'blizhniy-refund-growing-')),file=join(directory,'refunds.json');
+ try{
+  chmodSync(directory,0o700);writeFileSync(file,' '.repeat(4096),{mode:0o600});
+  const script=`import assert from 'node:assert/strict';import fs from 'node:fs';import {syncBuiltinESMExports} from 'node:module';
+   const stat=fs.fstatSync,read=fs.readSync;let total=0,checking=false;fs.fstatSync=fd=>checking?({...stat(fd),isFile:()=>true,size:100}):stat(fd);
+   fs.readSync=(fd,buffer,offset,length,position)=>{if(checking)assert.ok(buffer.length<=2049);const count=read(fd,buffer,offset,length,position);if(checking)total+=count;return count;};syncBuiltinESMExports();
+   const {readLocalPrimaryRefundConfig}=await import('./scripts/local-primary-refund-config.mjs');checking=true;
+   assert.throws(()=>readLocalPrimaryRefundConfig(process.argv[1],{origin:'https://127.0.0.1:3045',database:'blizhniy_prod'}),{message:'Local refund configuration unavailable'});assert.equal(total,2049);`;
+  const child=spawnSync(process.execPath,['--input-type=module','-e',script,file],{env:{PATH:process.env.PATH},encoding:'utf8',timeout:5000});assert.equal(child.status,0,child.stderr);
+ }finally{rmSync(directory,{recursive:true,force:true});}
+});
diff --git a/tests/local-primary-services.test.mjs b/tests/local-primary-services.test.mjs
new file mode 100644
index 0000000..b8d9d59
--- /dev/null
+++ b/tests/local-primary-services.test.mjs
@@ -0,0 +1,40 @@
+import assert from 'node:assert/strict';import {test} from 'node:test';
+import {startLocalPrimaryServices} from '../scripts/local-primary-services.mjs';
+const defer=()=>{let resolve;const promise=new Promise(r=>resolve=r);return{promise,resolve};};
+function fixture(){
+ const calls=[],controller=new AbortController(),refundDone=defer(),appDone=defer();
+ const handle=name=>({close:async()=>calls.push('close-'+name)});
+ const refund={...handle('refund'),socketPath:'/tmp/private.sock',done:refundDone.promise},proxy=handle('proxy'),app={...handle('app'),done:appDone.promise},expiry=handle('expiry');
+ const options={signal:controller.signal,createRefunds:async()=>{calls.push('refund');return refund;},createProxy:async socket=>{calls.push('proxy');assert.equal(socket,refund.socketPath);return proxy;},
+  startApplication:async()=>{calls.push('app');return app;},startExpiry:async()=>{calls.push('expiry');return expiry;},onReady:async()=>calls.push('ready')};
+ return{calls,controller,refundDone,appDone,refund,proxy,app,expiry,options};
+}
+test('local startup wires the socket before the app and caches ordered complete shutdown',async()=>{
+ const f=fixture(),service=await startLocalPrimaryServices(f.options);assert.deepEqual(f.calls,['refund','proxy','app','expiry','ready']);
+ const closing=service.close();assert.equal(service.close(),closing);await closing;assert.equal(await service.done,0);
+ assert.deepEqual(f.calls.slice(5),['close-refund','close-app','close-expiry','close-proxy']);
+});
+test('late resources after cancellation are closed and no later startup step runs',async()=>{
+ for(const key of ['createRefunds','createProxy','startApplication','startExpiry','onReady']){
+  const f=fixture(),entered=defer(),release=defer(),original=f.options[key];
+  f.options[key]=async(...args)=>{entered.resolve();await release.promise;return original(...args);};
+  const starting=startLocalPrimaryServices(f.options);await entered.promise;f.controller.abort();release.resolve();
+  await assert.rejects(starting,{message:'Local primary services unavailable'});
+  assert.equal(f.calls.filter(c=>c==='close-refund').length,1);
+  if(key==='createProxy')assert.equal(f.calls.includes('app'),false);
+ }
+});
+test('refund failure during pending proxy startup cannot resume into starting Next',async()=>{
+ const f=fixture(),entered=defer(),release=defer();f.options.createProxy=async()=>{entered.resolve();await release.promise;return f.proxy;};
+ const starting=startLocalPrimaryServices(f.options);await entered.promise;f.refundDone.resolve(1);await Promise.resolve();release.resolve();
+ await assert.rejects(starting,{message:'Local primary services unavailable'});assert.equal(f.calls.includes('app'),false);assert.ok(f.calls.includes('close-proxy'));
+});
+test('every acquired resource closes even when startup or an earlier close fails',async()=>{
+ const f=fixture();f.options.onReady=async()=>{throw Error('private configuration');};f.refund.close=async()=>{f.calls.push('close-refund');throw Error('private driver');};
+ await assert.rejects(startLocalPrimaryServices(f.options),{message:'Local primary services unavailable'});
+ assert.deepEqual(f.calls.slice(-4),['close-refund','close-app','close-expiry','close-proxy']);
+});
+test('unexpected app or worker exit closes ingress, while base startup needs no refund configuration',async()=>{
+ for(const name of ['refundDone','appDone']){const f=fixture(),service=await startLocalPrimaryServices(f.options);f[name].resolve(1);assert.equal(await service.done,1);await assert.rejects(service.close());assert.ok(f.calls.includes('close-proxy'));}
+ const f=fixture();delete f.options.createRefunds;f.options.createProxy=async socket=>{assert.equal(socket,undefined);return f.proxy;};const service=await startLocalPrimaryServices(f.options);await service.close();assert.equal(f.calls.includes('refund'),false);
+});
