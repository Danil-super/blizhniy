[Unit]
Description=Blizhniy restricted PostgreSQL user access operator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blizhniy-user-operator
Group=blizhniy-user-operator
WorkingDirectory=/opt/blizhniy-user-operator
Environment=NODE_ENV=production
EnvironmentFile=/etc/blizhniy/user-operator/operator.env
UnsetEnvironment=NODE_OPTIONS NODE_TLS_REJECT_UNAUTHORIZED
ExecStart=/opt/blizhniy-node22/bin/node /opt/blizhniy-user-operator/scripts/hosted-user-access-operator.mjs
UMask=0077
LimitCORE=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
