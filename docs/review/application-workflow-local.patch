+function headline(snapshot:ApplicationPaymentSnapshot){const {order,deliveredAt}=snapshot;
+ return order.status==='refunded'?'Платёж возвращён':order.status==='failed'?'Оплата не завершена':order.status==='succeeded'?deliveredAt?'Отклик доставлен':'Оплата подтверждена, доставка ожидается':order.status==='pending'?'Платёж обрабатывается':'Заказ ожидает оплаты';
