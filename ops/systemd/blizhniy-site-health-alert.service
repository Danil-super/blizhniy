[Unit]
Description=Send Blizhniy web and readiness outage notifications
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/blizhniy/site-monitor/monitor.env

[Service]
Type=oneshot
User=blizhniy-mail
Group=blizhniy-mail
WorkingDirectory=/var/www/blizhniy
Environment=NODE_ENV=production
EnvironmentFile=/etc/blizhniy/site-monitor/monitor.env
StateDirectory=blizhniy-site-monitor
StateDirectoryMode=0700
ExecStart=/opt/blizhniy-node22/bin/node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON /var/www/blizhniy/scripts/site-health-alert.mjs
TimeoutStartSec=90
UMask=0077
LimitCORE=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
