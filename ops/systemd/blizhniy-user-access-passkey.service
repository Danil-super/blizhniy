[Unit]
Description=Blizhniy PostgreSQL user access operator with passkey confirmation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blizhniy-user-operator
Group=blizhniy-user-operator
# Install the private staging package with root ownership and group read and traversal.
WorkingDirectory=/opt/blizhniy-user-operator-passkey
Environment=NODE_ENV=production
EnvironmentFile=/etc/blizhniy/user-operator/passkey.env
UnsetEnvironment=NODE_OPTIONS NODE_TLS_REJECT_UNAUTHORIZED
ExecStart=/opt/blizhniy-node22/bin/node /opt/blizhniy-user-operator-passkey/scripts/hosted-user-access-operator.mjs
UMask=0077
LimitCORE=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
