# Public site URL used for payment return URLs, canonical links and redirects.
# Local: http://localhost:3000
# Production: https://ближний-ру.рф
# Punycode equivalent: https://xn----9sbphbgks4a4a.xn--p1ai
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Target PostgreSQL backend (server-only, Node.js 22). New auth is local-only; legacy site remains unchanged.
# Supply explicit values through a protected server environment; never NEXT_PUBLIC_*.
# No DATABASE_URL, PG* or old Supabase credential fallback is supported.
BLIZHNIY_DB_HOST=
BLIZHNIY_DB_PORT=5432
BLIZHNIY_DB_NAME=default_db
BLIZHNIY_DB_USER=
BLIZHNIY_DB_PASSWORD=
BLIZHNIY_DB_SSL_MODE=verify-full
# Absolute path to the provider CA, outside the repository.
BLIZHNIY_DB_CA_FILE=
# "disable" is allowed only with literal 127.0.0.1/::1 in development/test.

# Local registration contour: disabled by default, NEVER available in production/remote DB mode.
# Uses synthetic *.invalid recipients and a loopback-only capture fixture, not real SMTP.
# The integration runner supplies random secrets/ports; do not put real credentials here.
BLIZHNIY_AUTH_MODE=
BLIZHNIY_AUTH_ORIGIN=
BLIZHNIY_LOCAL_MAIL_URL=
BLIZHNIY_AUTH_RATE_SECRET=

# New transactional mail adapter; not yet connected to registration or a durable outbox.
# Disabled when these variables are UNSET. Supply credentials via a protected server file/environment only.
# Fixed Timeweb endpoint: smtp.timeweb.ru:465, verified implicit TLS, fixed notifications sender.
# BLIZHNIY_MAIL_MODE=timeweb
# BLIZHNIY_SMTP_USER=notifications@xn----9sbphbgks4a4a.xn--p1ai
# BLIZHNIY_SMTP_PASSWORD=

# Legacy Supabase configuration: existing site until verified cutover.
# These values do not configure the new PostgreSQL module.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-side REST writes. Keep this value secret.
SUPABASE_SERVICE_ROLE_KEY=

# Initial admin email used in Supabase setup documentation
ADMIN_EMAIL=admin@example.ru

# Maps
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Payments: use "mock" only for local development. Production requires "yookassa".
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
# Use test_ keys only for local/staging checks. Production must use a live YooKassa secret.
YOOKASSA_SECRET_KEY=

# 54-FZ receipts from YooKassa. Enable only after completing the receipt
# settings in the YooKassa dashboard. vat_code: 1 = no VAT; select the
# applicable code with an accountant for the live store.
YOOKASSA_RECEIPTS_ENABLED=false
YOOKASSA_RECEIPT_VAT_CODE=

# YooKassa HTTP notification URL. Configure this HTTPS endpoint in the
# YooKassa dashboard; the server verifies every notification with YooKassa API.
# https://ближний-ру.рф/api/webhooks/yookassa

# Optional demo bypass for local admin testing only. Never enable in production.
ENABLE_DEMO_ADMIN_BYPASS=false
ENABLE_DEMO_CONTENT=false
NEXT_PUBLIC_ENABLE_DEMO_CONTENT=false

# Cloudflare Turnstile captcha
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
