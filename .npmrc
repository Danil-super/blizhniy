fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=120000
fund=false
audit=false
progress=false
# Default-deny dependency/root install lifecycle scripts. Explicit npm run scripts
# still execute, without implicit pre/post hooks; see docs/dependency-security.md.
ignore-scripts=true
# Match the packed file:vendor dependency recorded in package-lock.json across
# npm 9 and npm 10; do not link it or resolve its upstream devDependencies.
install-links=true
