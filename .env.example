# Public site URL used for payment return URLs, canonical links and redirects.
# Local: http://localhost:3000
# Production example: https://xn----9sbphbgks4a4a.xn--p1ai
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase browser/server auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-side REST writes. Keep this value secret.
SUPABASE_SERVICE_ROLE_KEY=

# Initial admin email used in Supabase setup documentation
ADMIN_EMAIL=admin@example.ru

# Maps
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Payments: use "mock" for local testing or "yookassa" for real payments
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=

# YooKassa HTTP notification URL:
# https://your-domain.ru/api/payments/yookassa/webhook?secret=YOOKASSA_WEBHOOK_SECRET

# Optional demo bypass for local admin testing only. Never enable in production.
ENABLE_DEMO_ADMIN_BYPASS=false

# Cloudflare Turnstile captcha
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
