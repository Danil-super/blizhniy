[Unit]
Description=Blizhniy TEST refund dispatch and compensation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blizhniy-refund-worker
Group=blizhniy-refund-worker
WorkingDirectory=/opt/blizhniy-refund-worker
Environment=NODE_ENV=production
EnvironmentFile=/etc/blizhniy/refund-worker/worker.env
UnsetEnvironment=NODE_OPTIONS NODE_TLS_REJECT_UNAUTHORIZED
ExecStart=/opt/blizhniy-node22/bin/node /opt/blizhniy-refund-worker/scripts/hosted-refund-worker.mjs --run
UMask=0077
LimitCORE=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
