# Direct public ingress, not behind a CDN or another load balancer.
# Adapt this template with Caddy 2.10.2. See captcha-boundary.md for older servers.
(origin_headers) {
    header_up X-Real-IP {remote_host}
    header_up -CF-Connecting-IP
    header_up X-Forwarded-For {remote_host}
}

example.com {
    # Next 15 hides/replays Flight headers around middleware. Normalize the
    # invalid document-prefetch combination before it reaches that adapter.
    @document_not_rsc {
        not header RSC 1
    }
    request_header @document_not_rsc -Next-Router-Prefetch
    request_header @document_not_rsc -Next-Router-Segment-Prefetch

    @versioned_assets {
        method GET HEAD
        path_regexp versioned ^/_next/static/(chunks/.+[-.][a-f0-9]{16}\.js|css/[a-f0-9]{16}\.css|media/[^/]+\.[a-f0-9]{8}\.webp|[a-f0-9]{40}/_(buildManifest|ssgManifest)\.js)$
    }
    route @versioned_assets {
        uri strip_prefix /_next/static
        @incoming file {
            root /var/www/blizhniy-static/incoming
            try_files {path}
        }
        # Caddy takes the first matching root in a route.
        root @incoming /var/www/blizhniy-static/incoming
        root * /var/www/blizhniy-static/running
        @available file {path}
        route @available {
            header {
                Cache-Control "public, max-age=31536000, immutable"
                match status 2xx 304
            }
            header {
                X-Content-Type-Options nosniff
                Cross-Origin-Resource-Policy same-origin
                Strict-Transport-Security max-age=31536000
                X-Frame-Options SAMEORIGIN
                Referrer-Policy strict-origin-when-cross-origin
                Permissions-Policy "camera=(), microphone=(), geolocation=()"
            }
            file_server
        }
        rewrite * {http.request.orig_uri}
    }

    reverse_proxy 127.0.0.1:3000 {
        # Next sends the destination as plain text for trailing-slash redirects.
        @permanent_redirect {
            status 308
            header Location *
        }
        handle_response @permanent_redirect {
            header ?Content-Type "text/plain; charset=utf-8"
            copy_response
        }

        # A missing dynamic category needs the server-rendered 404 document.
        @missing_html {
            status 404
            header Content-Type text/html*
        }
        handle_response @missing_html {
            @category_document {
                method GET HEAD
                path /katalog/*
                not header RSC 1
            }
            route {
                reverse_proxy @category_document {http.reverse_proxy.upstream.address} {
                    rewrite /_not-found?
                    import origin_headers
                }
                copy_response
            }
        }
        import origin_headers
    }
}
