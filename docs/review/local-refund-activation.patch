+  assertLocalPrimaryRefundTrust(ownerConfig,certificate);signal.throwIfAborted();
+  ownerDb=new PostgresDatabase(new pg.Pool({...ownerConfig,max:2,application_name:'blizhniy-local-refund-provider'}));
