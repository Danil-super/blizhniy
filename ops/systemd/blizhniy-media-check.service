[Unit]
Description=BLIZHNIY isolated photo processing proof (synthetic pixels only)

[Service]
Type=oneshot
User=blizhniy-media
Group=blizhniy-media
WorkingDirectory=/var/www/blizhniy
ExecStart=/opt/blizhniy-node22/bin/node --experimental-strip-types --no-warnings /var/www/blizhniy/scripts/media-sandbox-check.mjs --check
Environment=NODE_ENV=production
Environment=UV_THREADPOOL_SIZE=2
Environment=VIPS_CONCURRENCY=1
MemoryMax=512M
MemorySwapMax=0
CPUQuota=100%
TasksMax=32
TimeoutStartSec=8
TimeoutStopSec=2
KillMode=control-group
KillSignal=SIGKILL
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
InaccessiblePaths=-/etc/blizhniy -/var/lib/blizhniy-web
InaccessiblePaths=-/var/www/blizhniy/.env -/var/www/blizhniy/.env.local -/var/www/blizhniy/.env.production -/var/www/blizhniy/.env.production.local
LimitCORE=0
LimitNOFILE=256
UMask=0077
