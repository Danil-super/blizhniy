+  if(typeof window!=='undefined'||process.env.NODE_ENV!=='test'||process.env.BLIZHNIY_LOCAL_PRIMARY!=='enabled'||
+   process.env.NODE_TLS_REJECT_UNAUTHORIZED==='0'||Object.keys(process.env).some(key=>key.startsWith('PG'))||
